<% content_for :title, "Roomies - Find Your Next Room" %>

<div class="text-center mb-5">
  <h1 class="fw-bold">Find Your Next Roommate</h1>
  <p class="text-muted">Browse available rooms or list your space.</p>
</div>

<div class="row justify-content-center mb-5">
  <div class="col-md-8">
    <%= form_with url: listings_path, method: :get, local: true, class: "input-group" do |f| %>
      <%= f.text_field :neighborhood, class: "form-control", placeholder: "Search by neighborhood..." %>
      <%= f.submit "Search", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

<h2 class="h4 mb-3">Available Rooms</h2>
<div class="row g-3">
  <% Listing.published.includes(:property).order(created_at: :desc).limit(3).each do |listing| %>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title"><%= listing.property.neighborhood %></h5>
          <p class="card-text text-muted">
            $<%= number_with_delimiter(listing.monthly_rent.to_i) %>/month &bull;
            <%= listing.property.bedrooms %> Bed, <%= listing.property.bathrooms %> Bath
          </p>
          <%= link_to "View Details", listing_path(listing), class: "btn btn-sm btn-outline-secondary" %>
        </div>
      </div>
    </div>
  <% end %>
</div>