<turbo-frame id="application_frame">
  <% if application.persisted? %>
    <div class="border rounded p-3">
      <p class="mb-2">
        Your application: <span class="badge bg-secondary text-uppercase"><%= application.state %></span>
      </p>

      <% if application.errors.any? %>
        <div class="alert alert-danger py-2 px-3 mb-2">
          <%= application.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <% if %w[pending shortlisted].include?(application.state) %>
        <%= button_to "Withdraw application", listing_application_path(listing), method: :delete,
              class: "btn btn-sm btn-outline-danger" %>
      <% end %>
    </div>
  <% else %>
    <%= render "applications/form", listing: listing, application: application %>
  <% end %>
</turbo-frame>