<% content_for :title, "My profile" %>

<div class="row justify-content-center">
  <div class="col-md-6">
    <h1 class="h3 mb-4">My profile</h1>

    <%= form_with model: @user, url: profile_path, method: :patch, local: true do |f| %>
      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :name, class: "form-label" %>
        <%= f.text_field :name, required: true, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, required: true, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :phone, "Phone number", class: "form-label" %>
        <%= f.telephone_field :phone, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :bio, "Short bio", class: "form-label" %>
        <%= f.text_area :bio, rows: 4, class: "form-control" %>
      </div>

      <%= f.submit "Save changes", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>