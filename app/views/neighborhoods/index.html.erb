<% content_for :title, "Neighborhoods - Roomies" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Neighborhoods</h1>
  <%= link_to "New neighborhood", new_neighborhood_path, class: "btn btn-primary btn-sm" %>
</div>

<% if @neighborhoods.any? %>
  <ul class="list-group">
    <% @neighborhoods.each do |neighborhood| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <%= neighborhood.name %>
        <div class="d-flex gap-1">
          <%= link_to "Edit", edit_neighborhood_path(neighborhood), class: "btn btn-sm btn-outline-secondary" %>
          <%= button_to "Delete", neighborhood, method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Delete this neighborhood?" } %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-muted">No neighborhoods yet.</p>
<% end %>