<div class="mt-2 border-top pt-2">
  <p class="mb-1">
    Visit: <%= visit.proposed_date.strftime("%b %-d, %Y %H:%M") %>
    <span class="badge bg-secondary text-uppercase"><%= visit.status %></span>
  </p>

  <div class="d-flex gap-1 flex-wrap">
    <% if visit.status == "scheduled" %>
      <%= button_to "Confirm", application_visit_path(visit.application, status: "confirmed"), method: :patch, class: "btn btn-sm btn-outline-primary" %>
    <% end %>
    <% unless visit.completed? || visit.cancelled? %>
      <%= button_to "Cancel", application_visit_path(visit.application, status: "cancelled"), method: :patch, class: "btn btn-sm btn-outline-danger" %>
    <% end %>
    <% if visit.status == "confirmed" %>
      <%= button_to "Mark completed", application_visit_path(visit.application, status: "completed"), method: :patch, class: "btn btn-sm btn-success" %>
    <% end %>
  </div>

  <% unless visit.completed? || visit.cancelled? %>
    <%= form_with url: application_visit_path(visit.application), method: :patch, local: true, class: "row g-2 align-items-end mt-2" do %>
      <input type="hidden" name="status" value="scheduled">
      <div class="col-auto">
        <%= label_tag "reschedule_date", "Reschedule to", class: "form-label" %>
        <%= datetime_local_field_tag "proposed_date", nil, class: "form-control form-control-sm" %>
      </div>
      <div class="col-auto">
        <%= submit_tag "Reschedule", class: "btn btn-sm btn-outline-secondary" %>
      </div>
    <% end %>
  <% end %>
</div>