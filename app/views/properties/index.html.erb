<% content_for :title, "Your Properties - Roomies" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Your properties</h1>
  <%= link_to "New property", new_property_path, class: "btn btn-primary btn-sm" %>
</div>

<% if @properties.any? %>
  <ul class="list-group">
    <% @properties.each do |property| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <div>
          <strong><%= property.address %></strong> &bull; <%= property.neighborhood.name %>
          &bull; <%= pluralize(property.listings.count, "listing") %>
        </div>
        <%= link_to "Manage", property_path(property), class: "btn btn-sm btn-outline-secondary" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-muted">You haven't listed a property yet.</p>
<% end %>