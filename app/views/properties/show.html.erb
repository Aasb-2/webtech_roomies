<% content_for :title, "#{@property.neighborhood.name} Property - Roomies" %>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
  <div>
    <h1 class="h3"><%= @property.address %></h1>
    <p class="text-muted">
      <%= @property.property_type.capitalize %> in <%= @property.neighborhood.name %> &bull;
      <%= @property.bedrooms %> bedrooms, <%= @property.bathrooms %> bathrooms
      <% if @property.average_rating %>
        &bull; <%= @property.average_rating %>/5 average rating
      <% end %>
    </p>
  </div>

  <% if @property.host_id == current_user.id %>
    <div class="d-flex gap-2">
      <%= link_to "Edit property", edit_property_path(@property), class: "btn btn-outline-secondary btn-sm" %>
      <%= button_to "Delete", @property, method: :delete, class: "btn btn-outline-danger btn-sm", data: { turbo_confirm: "Delete this property and all its listings?" } %>
    </div>
  <% end %>
</div>

<% if @property.amenities.any? %>
  <ul class="list-inline mt-2">
    <% @property.amenities.each do |amenity| %>
      <li class="list-inline-item badge bg-light text-dark border"><%= amenity.name %></li>
    <% end %>
  </ul>
<% end %>

<% if @property.shared_spaces.present? %>
  <p><strong>Shared spaces:</strong> <%= @property.shared_spaces %></p>
<% end %>

<% if @host_listings %>
  <h2 class="h5 mt-4">Your listings</h2>
  <%= link_to "New listing", new_property_listing_path(@property), class: "btn btn-sm btn-primary mb-2" %>

  <% if @host_listings.any? %>
    <ul class="list-group mb-4">
      <% @host_listings.each do |listing| %>
        <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div>
            $<%= number_with_delimiter(listing.monthly_rent.to_i) %>/month &bull;
            <span class="badge bg-secondary text-uppercase"><%= listing.state %></span>
          </div>
          <div class="d-flex gap-1 flex-wrap">
            <%= link_to "View", listing_path(listing), class: "btn btn-sm btn-outline-secondary" %>
            <%= link_to "Edit", edit_property_listing_path(@property, listing), class: "btn btn-sm btn-outline-secondary" %>
            <% if listing.draft? %>
              <%= button_to "Publish", publish_property_listing_path(@property, listing), method: :patch, class: "btn btn-sm btn-success" %>
            <% end %>
            <% if listing.reserved? %>
              <%= button_to "Mark rented", mark_rented_property_listing_path(@property, listing), method: :patch, class: "btn btn-sm btn-success" %>
            <% end %>
            <% unless listing.rented? || listing.withdrawn? %>
              <%= button_to "Withdraw", withdraw_property_listing_path(@property, listing), method: :patch, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Withdraw this listing?" } %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted">No listings yet for this property.</p>
  <% end %>
<% else %>
  <h2 class="h5 mt-4">Published listings</h2>
  <% if @published_listings.any? %>
    <ul class="list-group mb-4">
      <% @published_listings.each do |listing| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          $<%= number_with_delimiter(listing.monthly_rent.to_i) %>/month, available <%= listing.available_date.strftime("%b %-d, %Y") %>
          <%= link_to "View", listing_path(listing), class: "btn btn-sm btn-outline-secondary" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted">No published listings for this property right now.</p>
  <% end %>
<% end %>

<h2 class="h5 mt-4">Reviews</h2>
<% if @reviews.any? %>
  <% @reviews.each do |review| %>
    <div class="border rounded p-3 mb-2">
      <strong><%= review.rating %>/5</strong>
      <p class="mb-0"><%= review.comment %></p>
    </div>
  <% end %>
<% else %>
  <p class="text-muted">No reviews yet.</p>
<% end %>

<% if @can_review %>
  <h3 class="h6 mt-4">Leave a review</h3>
  <%= form_with model: @review, url: property_reviews_path(@property), local: true do |f| %>
    <% if @review.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @review.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= f.label :rating, class: "form-label" %>
      <%= f.select :rating, (1..5).to_a.reverse, {}, class: "form-select" %>
    </div>

    <div class="mb-3">
      <%= f.label :comment, class: "form-label" %>
      <%= f.text_area :comment, class: "form-control", rows: 3 %>
    </div>

    <%= f.submit "Submit review", class: "btn btn-primary" %>
  <% end %>
<% end %>