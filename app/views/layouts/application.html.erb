<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Roomies" %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="My App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-light roomies-navbar">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand fw-bold roomies-brand" do %>
          <i class="bi bi-house-heart-fill roomies-brand__icon"></i> Roomies
        <% end %>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <%= link_to listings_path, class: "btn btn-outline-primary btn-sm" do %>
            <i class="bi bi-search"></i> Browse Listings
          <% end %>

          <% if authenticated? %>
            <%= link_to properties_path, class: "btn btn-outline-secondary btn-sm" do %>
              <i class="bi bi-houses"></i> My Properties
            <% end %>
            <%= link_to applications_path, class: "btn btn-outline-secondary btn-sm" do %>
              <i class="bi bi-inbox"></i> Applications
            <% end %>
          <% end %>

          <% if current_user&.moderator? %>
            <%= link_to "Neighborhoods", neighborhoods_path, class: "btn btn-outline-secondary btn-sm" %>
            <%= link_to "Amenities", amenities_path, class: "btn btn-outline-secondary btn-sm" %>
            <%= link_to "Reports", reports_path, class: "btn btn-outline-secondary btn-sm" %>
          <% end %>

          <% if authenticated? %>
            <%= link_to "My Profile", edit_profile_path, class: "btn btn-outline-secondary btn-sm ms-2" %>
            <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-sm btn-outline-dark ms-2" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "btn btn-sm btn-outline-dark ms-2" %>
            <%= link_to "Sign up", new_registration_path, class: "btn btn-sm btn-dark" %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="container py-4">
      <% if notice.present? %>
        <div class="alert alert-success d-flex align-items-center gap-2">
          <i class="bi bi-check-circle-fill"></i> <%= notice %>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-danger d-flex align-items-center gap-2">
          <i class="bi bi-exclamation-triangle-fill"></i> <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
