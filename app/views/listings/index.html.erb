<% content_for :title, "Browse Listings - Roomies" %>

<h1 class="h3 mb-4">Browse Listings</h1>

<div data-controller="search">
  <div class="search-panel mb-4">
    <%= form_with url: listings_path, method: :get, local: true, class: "row g-2",
          data: { search_target: "form", action: "submit->search#search" } do |f| %>
      <div class="col-md-3">
        <%= f.select :neighborhood_id, options_from_collection_for_select(@neighborhoods, :id, :name, params[:neighborhood_id]),
              { include_blank: "Any neighborhood" }, class: "form-select" %>
      </div>
      <div class="col-md-2">
        <%= f.number_field :max_rent, value: params[:max_rent], placeholder: "Max rent", class: "form-control" %>
      </div>
      <div class="col-md-3">
        <%= f.date_field :available_from, value: params[:available_from], class: "form-control" %>
      </div>
      <div class="col-md-2">
        <%= f.select :amenity_id, options_from_collection_for_select(@amenities, :id, :name, params[:amenity_id]),
              { include_blank: "Any amenity" }, class: "form-select" %>
      </div>
      <div class="col-md-2">
        <%= f.submit "Filter", class: "btn btn-primary w-100" %>
      </div>
    <% end %>
  </div>

  <div data-search-target="results">
    <% if @listings.any? %>
      <div class="row g-3">
        <% @listings.each do |listing| %>
          <div class="col-md-4">
            <div class="card h-100 listing-card">
              <% if listing.photos.attached? %>
                <div class="listing-card__img-wrap">
                  <%= image_tag listing.cover_photo.variant(resize_to_limit: [400, 300]), class: "card-img-top" %>
                </div>
              <% end %>
              <div class="card-body">
                <h5 class="card-title"><%= listing.property.neighborhood.name %> &bull; <%= listing.property.property_type.capitalize %></h5>
                <p class="card-text text-muted mb-1">
                  <span class="listing-card__price">$<%= number_with_delimiter(listing.monthly_rent.to_i) %>/month</span>
                  &bull; <%= listing.property.bedrooms %> Bed, <%= listing.property.bathrooms %> Bath
                </p>
                <p class="card-text text-muted mb-1">
                  Available <%= listing.available_date.strftime("%b %-d, %Y") %>
                  <% if listing.furnished? %> &bull; Furnished <% end %>
                  <% if listing.private_bathroom? %> &bull; Private bathroom <% end %>
                </p>
                <%= link_to "View Details", listing_path(listing), class: "btn btn-sm btn-outline-secondary mt-2" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <i class="bi bi-search empty-state__icon"></i>
        <p class="mb-0 text-muted">No listings match your search. Try adjusting your filters.</p>
      </div>
    <% end %>
  </div>
</div>
