<% content_for :title, "Forgot your password?" %>

<div class="row justify-content-center">
  <div class="col-md-5">
    <h1 class="h3 mb-4">Forgot your password?</h1>

    <%= form_with url: passwords_path, local: true do |f| %>
      <div class="mb-3">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, required: true, autofocus: true, class: "form-control" %>
      </div>

      <%= f.submit "Send reset link", class: "btn btn-primary w-100" %>
    <% end %>
  </div>
</div>